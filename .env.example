# Optional override for a nonstandard Spotify callback URL.
# The app normally derives this automatically from the current page URL.
# VITE_SPOTIFY_REDIRECT_URI=https://example.com/Minecraft-Tracker/callback

# Optional self-hosted PeerServer (https://github.com/peers/peerjs-server).
# Room connections use the free public PeerJS broker when these are unset.
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
